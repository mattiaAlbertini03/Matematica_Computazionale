      "], "Real32", ColorSpace -> Automatic, Interleaving -> True], 
    Private`aiuti = 0, Private`mostraValori = False}, 
   Panel[
    Column[{
      Style["Benvenuto ds", Bold, 
       RGBColor[0, 0.35, 0], 20], 
      Pane[
       Row[{
         Column[{
           Style["Immagine modificata", Bold], 
           Dynamic[
            Show[
            Private`immagineModificata, 
             ImageSize -> {Automatic, Private`ALTEZZAIMMAGINE}]]}, Alignment -> 
          Top], 
         Spacer[30], 
         Column[{
           Style["La tua immagine", Bold], 
           DynamicModule[{}, 
            Dynamic[
             Show[
              TrasformazioneImmagini`modificaImmagine[
              Private`img, Private`blur, Private`rotazione, Private`translaX, 
               Private`translaY, Private`colore, Private`MAXTRANSLATIONSTEP], 
              ImageSize -> {Automatic, Private`ALTEZZAIMMAGINE}]], 
            DynamicModuleValues :> {}]}, Alignment -> Top]}, Alignment -> 
        Center], {Full, 160}], 
      Row[{
        DynamicModule[{}, 
         Column[{
           Row[{"Blur:       ", 
             Slider[
              Dynamic[Private`blur], {0, 50, 10}, Appearance -> "Labeled"]}], 
           
           Row[{"Rotazione: ", 
             Slider[
              Dynamic[Private`rotazione], {0, 359, 30}, Appearance -> 
              "Labeled"]}], 
           Row[{"Colore:     ", 
             RadioButtonBar[
              Dynamic[Private`colore], {None, 
               RGBColor[1, 0, 0], 
               RGBColor[0, 1, 0], 
               RGBColor[0, 0, 1], 
               RGBColor[1, 1, 0], 
               RGBColor[0, 1, 1], 
               RGBColor[1, 0, 1], 
               RGBColor[1, 0.5, 0]}]}], 
           Row[{"Transla X: ", 
             Slider[
              Dynamic[Private`translaX], {0, 10, 1}, Appearance -> 
              "Labeled"]}], 
           Row[{"Transla Y: ", 
             Slider[
              Dynamic[Private`translaY], {0, 10, 1}, Appearance -> 
              "Labeled"]}]}, Alignment -> Left], DynamicModuleValues :> {}], 
        Spacer[40], 
        Column[{
          Dynamic[
           Style["Partita n: " <> ToString[Private`partite], Bold]], 
          Dynamic[
           Style["Punteggio: " <> ToString[Private`punteggio$$], Bold, 
            RGBColor["#2ecc71"]]], 
          Dynamic[
           Style["Aiuti: " <> ToString[Private`aiuti], Bold, Orange]], 
          Spacer[10], 
          Button[
          "Risolvi esercizio", Private`blur = Private`blur2; 
           Private`rotazione = Private`rotazione2; 
           Private`colore = Private`colore2; 
           Private`translaX = Private`translaX2; 
           Private`translaY = Private`translaY2; Private`aiuti = 5; Null, 
           ImageSize -> {100, 35}], 
          Button[
           Dynamic[
            If[
            Private`mostraValori, "Nascondi soluzione", "Mostra soluzione"]], 
           Private`aiuti = 5; 
           Private`mostraValori = Not[Private`mostraValori], 
           ImageSize -> {100, 35}], 
          Dynamic[
           If[Private`mostraValori, 
            Private`formattaSoluzione[
            Private`blur2, Private`colore2, Private`rotazione2, 
             Private`translaX2, Private`translaY2], ""]], 
          Spacer[10], 
          Button[
           Style["Verifica", 
            GrayLevel[1], Bold], 
           If[
            
            Private`verifica[{
             Private`blur, Private`colore, Private`rotazione, 
              Private`translaX, Private`translaY}, {
             Private`blur2, Private`colore2, Private`rotazione2, 
              Private`translaX2, Private`translaY2}], 
            Private`punteggioLivello = Max[5 - Private`aiuti, 0]; 
            MessageDialog[
              StringTemplate["Corretto: punteggio `1`, aiuti utilizzati `2`"][
              Private`punteggioLivello, Private`aiuti]]; 
            Private`punteggio$$ = 
             Private`punteggio$$ + Private`punteggioLivello; 
            Private`aiuti = 0; Private`mostraValori = False; 
            Private`partite = Private`partite + 1; 
            Private`pulisci[
             Private`blur, Private`rotazione, Private`translaX, 
              Private`translaY, Private`colore]; 
            Private`img = Private`prossimaImmagine[]; 
            Private`aggiornaParametri[{
              Private`blur2, Private`colore2, Private`rotazione2, 
               Private`translaX2, Private`translaY2}]; 
            Private`immagineModificata = 
             TrasformazioneImmagini`modificaImmagine[
              Private`img, Private`blur2, Private`rotazione2, 
               Private`translaX2, Private`translaY2, Private`colore2, 
               Private`MAXTRANSLATIONSTEP]; Null, 
            MessageDialog["sbagliato"]], Background -> 
           RGBColor[
            0.08627450980392157, 0.6274509803921569, 0.5215686274509804], 
           ImageSize -> {100, 35}], 
          Button[
           Style["Prossimo Esercizio", 
            GrayLevel[1], Bold], Private`aiuti = 0; 
           Private`mostraValori = False; 
           Private`partite = Private`partite + 1; 
           Private`pulisci[
            Private`blur, Private`rotazione, Private`translaX, 
             Private`translaY, Private`colore]; 
           Private`img = Private`prossimaImmagine[]; 
           Private`aggiornaParametri[{
             Private`blur2, Private`colore2, Private`rotazione2, 
              Private`translaX2, Private`translaY2}]; 
           Private`immagineModificata = 
            TrasformazioneImmagini`modificaImmagine[
             Private`img, Private`blur2, Private`rotazione2, 
              Private`translaX2, Private`translaY2, Private`colore2, 
              Private`MAXTRANSLATIONSTEP]; Null, Background -> 
           RGBColor[
            0.1607843137254902, 0.5019607843137255, 0.7254901960784313], 
           ImageSize -> {100, 35}, Appearance -> "Framed"], 
          Button[
           Style["Aiuto", 
            GrayLevel[1], Bold, 12], 
           Private`aiuti = Min[Private`aiuti + 1, 5]; 
           If[Private`aiuti >= 1, Private`blur = Private`blur2]; 
           If[Private`aiuti >= 2, Private`rotazione = Private`rotazione2]; 
           If[Private`aiuti >= 3, Private`colore = Private`colore2]; 
           If[Private`aiuti >= 4, Private`translaX = Private`translaX2]; 
           If[Private`aiuti >= 5, Private`translaY = Private`translaY2]; Null,
            Background -> 
           RGBColor[
            0.5568627450980392, 0.26666666666666666`, 0.6784313725490196], 
           ImageSize -> {100, 35}, Appearance -> "Framed"], 
          Spacer[10], 
          DynamicModule[{}, 
           Button[
            Style["Pulisci", 
             GrayLevel[1], Bold, 12], 
            Private`pulisci[
             Private`blur, Private`rotazione, Private`translaX, 
              Private`translaY, Private`colore]; Null, Background -> 
            RGBColor[
             0.9019607843137255, 0.49411764705882355`, 0.13333333333333333`], 
            ImageSize -> {100, 35}, Appearance -> "Framed"], 
           DynamicModuleValues :> {}]}, Alignment -> Center, ItemSize -> 20]},
        Alignment -> Center], 
      Panel[
       Column[{
         Style["LEADERBOARD", 24, Bold, 
          RGBColor[0, 0, 
           Rational[2, 3]]], 
         Spacer[10], 
         Row[{
           Column[{
             Style["-", 14, Bold], 
