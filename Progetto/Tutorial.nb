Cell[CellGroupData[{

Cell["Applicazione Filtro Colore", "Section",
 Editable->False,
 CellChangeTimes->{{3.985418660281992*^9, 3.9854186889265957`*^9}, {
  3.9854187409947453`*^9, 3.9854187445206003`*^9}, {3.985418852290518*^9, 
  3.98541885532421*^9}, {3.987337380632711*^9, 3.987337392043146*^9}},
 FontFamily->"Sans Serif",
 CellTags->
  "cambio_colore",ExpressionUUID->"39189fae-23fd-4d1c-a345-ef3ef7c07e15"],

Cell[TextData[{
 "L\[CloseCurlyQuote]applicazione di un filtro colore modifica la tinta di un\
\[CloseCurlyQuote]immagine preservandone i dettagli di luci e ombre, cos\
\[IGrave] da mantenere intatta la leggibilit\[AGrave] delle forme.\nPer farlo \
in modo efficace, si lavora nello spazio colore HSV ",
 ButtonBox["[9]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_9"],
 " ",
 ButtonBox["[10]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_10"],
 " ",
 ButtonBox["[11]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_11"],
 " anzich\[EAcute] in quello classico RGB:\n\t",
 StyleBox["Hue",
  FontWeight->"Bold"],
 " (Tinta): \[CapitalEGrave] il \[OpenCurlyDoubleQuote]colore\
\[CloseCurlyDoubleQuote] puro che viene modificato.\n\t",
 StyleBox["Saturation",
  FontWeight->"Bold"],
 " (Saturazione): Determina l\[CloseCurlyQuote]intensit\[AGrave] del colore \
(da acceso a spento/grigio).\n\t",
 StyleBox["Value",
  FontWeight->"Bold"],
 " (Luminosit\[AGrave]): Rappresenta le luci e le ombre originali; non viene \
modificato, \t\tgarantendo che i volumi rimangano fedeli \
all\[CloseCurlyQuote]originale.\nIn Mathematica, si ottiene questo risultato \
utilizzando Colorize per applicare il filtro e ColorConvert per gestire la \
conversione tra i vari spazi colore. ",
 ButtonBox["[12]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_12"],
 " ",
 ButtonBox["[13]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_13"],
 " ",
 ButtonBox["[14]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_14"]
}], "Text",
 Editable->False,
 CellChangeTimes->{
  3.987332305065816*^9, {3.987480403708721*^9, 3.987480448990424*^9}, {
   3.987480486136881*^9, 3.98748052780614*^9}, {3.987501171049774*^9, 
   3.987501191193305*^9}, {3.9890594142482815`*^9, 3.9890594911806507`*^9}},
 FontFamily->
  "Sans Serif",ExpressionUUID->"5646874f-2412-4bbf-909b-71d10c70c968"],

