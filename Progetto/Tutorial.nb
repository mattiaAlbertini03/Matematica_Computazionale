Cell[TextData[{
 StyleBox["Inizializzazione dell\[CloseCurlyQuote]ambiente di notebook",
  FontWeight->"Bold"],
 ": come prima cosa si deve cliccare sul bottone \[OpenCurlyQuote]Inizializza \
Ambiente\[CloseCurlyQuote] per permettere il caricamento dei pacchetti \
necessari per il corretto funzionamento del programma."
}], "ItemNumbered",
