Cell[CellGroupData[{

Cell[TextData[{
 "Impostare il database presso cui le immagini vengono selezionate. L\
\[CloseCurlyQuote]utente con l\[CloseCurlyQuote]apposito men\[UGrave] a \
tendina, vicino alla scritta \[OpenCurlyQuote]",
 StyleBox["Sorgente immagini",
  FontWeight->"Bold"],
 "\[CloseCurlyQuote], pu\[OGrave] selezionare un database Web (attraverso cui \
le immagini vengono fornite direttamente dal database di Wolfram) oppure un \
database locale (attraverso cui le immagini vengono caricate direttamente \
dalla cartella \[OpenCurlyQuote]img\[CloseCurlyQuote] nella stessa directory \
di questo notebook) e cliccare su \[OpenCurlyQuote]",
 StyleBox["Carica database",
  FontWeight->"Bold"],
 "\[CloseCurlyQuote] per avviare il caricamento. "
}], "Item",
 Editable->False,
