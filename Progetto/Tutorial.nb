Cell[TextData[{
 StyleBox["N.B.",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 " per il database Web \[EGrave] necessaria una connessione internet ed \
aspettare qualche minuto che sia avvenuto il corretto download delle \
corrispondenti immagini."
}], "Subitem",
