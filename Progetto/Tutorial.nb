Cell["\<\
Il progetto presentato pu\[OGrave] essere facilmente migliorato, ad esempio \
attraverso:\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.98773531901157*^9, 3.987735464644936*^9}, 
   3.987924140440671*^9, {3.988119402516543*^9, 
   3.988119421946257*^9}},ExpressionUUID->"8155ed01-a481-4a6e-8284-\
64e12d578de6"],

Cell[TextData[StyleBox["L\[CloseCurlyQuote]aggiunta di altre trasformazioni, \
oltre a quelle gi\[AGrave] presentate, come il \[OpenCurlyQuote]negativo dell\
\[CloseCurlyQuote]immagine\[CloseCurlyQuote] o la \
\[OpenCurlyQuote]saturazione\[CloseCurlyQuote].", "Item",
 FontFamily->"Sans Serif"]], "Item",
 Editable->False,
 CellChangeTimes->{{3.9864446715425463`*^9, 3.9864446916795263`*^9}, {
  3.987237182780486*^9, 3.987237208015874*^9}, {3.9872373481356297`*^9, 
  3.98723736416743*^9}, {3.987274917554603*^9, 3.987274949897882*^9}, {
  3.987313384120294*^9, 3.987313470967908*^9}, {3.987313818365478*^9, 
  3.987313919898061*^9}, {3.987324398543724*^9, 3.987324405874263*^9}, {
  3.987328029205298*^9, 3.9873282339295053`*^9}, {3.987412768915791*^9, 
  3.98741276985326*^9}, {3.9875002435216923`*^9, 3.98750025253389*^9}, {
  3.987500291229021*^9, 3.987500344665666*^9}, {3.987500475254322*^9, 
