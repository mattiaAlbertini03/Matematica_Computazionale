Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Button", "[", 
  RowBox[{
   RowBox[{"Style", "[", 
    RowBox[{"\"\<\[FilledRightTriangle]  Inizializza Ambiente\>\"", ",", 
     RowBox[{"FontSize", "->", "16"}], ",", 
     RowBox[{"FontWeight", "->", "Bold"}], ",", 
     RowBox[{"FontColor", "->", "White"}]}], "]"}], ",", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "nb", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"1.", " ", "Notebook", " ", "corrente"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"nb", "=", 
       RowBox[{"EvaluationNotebook", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"2.", " ", "Pulizia", " ", "memoria"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"3.", " ", "Directory", " ", "di", " ", "lavoro"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], "=!=", "$Failed"}], ",", 
        RowBox[{"SetDirectory", "[", 
         RowBox[{"NotebookDirectory", "[", "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"4.", " ", "Caricamento", " ", "pacchetti"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Quiet", "@", 
       RowBox[{"Get", "[", "\"\<TrasformazioneImmagini`\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Quiet", "@", 
       RowBox[{"Get", "[", "\"\<Interfaccia`\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"5.", " ", "Messaggio"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"MessageDialog", "[", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<\[Checkmark]  Ambiente inizializzato!\>\"", ",", 
         RowBox[{"FontSize", "->", "14"}]}], "]"}], "]"}], ";"}]}], "]"}], ",", 
   RowBox[{"Background", "->", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0.2", ",", "0.5", ",", "0.9"}], "]"}]}], ",", 
   RowBox[{"FrameMargins", "->", "15"}], ",", 
   RowBox[{"ImageSize", "->", 
    RowBox[{"{", 
     RowBox[{"350", ",", "60"}], "}"}]}], ",", 
   RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9852345631188126`*^9, 3.985234590279291*^9}, {
   3.9852347972227383`*^9, 3.9852348286767197`*^9}, {3.9852349255610237`*^9, 
   3.985234941411022*^9}, 3.9852349999715996`*^9, {3.9852383593437977`*^9, 
   3.985238381848522*^9}, {3.9852384160115337`*^9, 3.9852384814436264`*^9}, {
   3.985238530761965*^9, 3.9852385502085724`*^9}, {3.9852386261496353`*^9, 
   3.985238631805979*^9}, {3.9852386899292355`*^9, 3.985238715685087*^9}, 
   3.9852387459845676`*^9, 3.985238932382555*^9, 3.985239023336111*^9, 
   3.985239239984894*^9, {3.985239367287855*^9, 3.985239372804121*^9}, {
   3.9852394853062935`*^9, 3.9852395101951294`*^9}, {3.9852395848792057`*^9, 
   3.985239612445196*^9}, 3.985240157184496*^9, {3.9852402272395763`*^9, 
   3.985240227757168*^9}, {3.9852405124210567`*^9, 3.985240560218754*^9}, {
   3.985240958501772*^9, 3.985240960024681*^9}, 3.9860271186346397`*^9, {
   3.986027179099594*^9, 3.986027188011156*^9}, {3.9860274218400087`*^9, 
   3.986027429991893*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"8874232a-570a-4c00-9eea-ccbd29bf3f74"],

Cell[BoxData[
 ButtonBox[
  StyleBox["\<\"\[FilledRightTriangle]  Inizializza Ambiente\"\>",
   StripOnInput->False,
   FontSize->16,
   FontWeight->Bold,
   FontColor->GrayLevel[1]],
  Appearance->Automatic,
  Background->RGBColor[0.2, 0.5, 0.9],
  ButtonFunction:>
   Module[{$CellContext`nb}, $CellContext`nb = EvaluationNotebook[]; 
    ClearAll["Global`*"]; If[NotebookDirectory[] =!= $Failed, 
      SetDirectory[
       NotebookDirectory[]]]; Quiet[
      Get["TrasformazioneImmagini`"]]; Quiet[
      Get["Interfaccia`"]]; MessageDialog[
      Style["\[Checkmark]  Ambiente inizializzato!", FontSize -> 14]]; Null],
  Evaluator->Automatic,
  FrameMargins->15,
  ImageSize->{350, 60},
  Method->"Queued"]], "Output",
 CellChangeTimes->{
  3.986027151390562*^9, 3.9860274447800293`*^9, 3.986027526146286*^9, 
   3.9860275983038597`*^9, 3.98602773006145*^9, 3.986890710829171*^9, 
   3.9868910750760508`*^9, 3.9868911203457737`*^9, 3.9868912409110126`*^9, 
