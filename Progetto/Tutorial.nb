              Column[{
                Style["ds", 12, 
                 GrayLevel[1]], 
                Style[0, 22, 
                 GrayLevel[1], Bold]}, Alignment -> Center], Background -> 
              RGBColor[1, 0.84, 0], FrameStyle -> None, 
              ImageSize -> {100, 120}, Alignment -> Center], 
             Style["1\.ba", 18, 
              GrayLevel[0.5]]}, Alignment -> Center], 
           Column[{
             Style["-", 14, Bold], 
             Framed[
              Column[{
                Style["-", 12, 
                 GrayLevel[1]], 
                Style[0, 22, 
                 GrayLevel[1], Bold]}, Alignment -> Center], Background -> 
              RGBColor[0.8, 0.5, 0.2], FrameStyle -> None, 
              ImageSize -> {100, 60}, Alignment -> Center], 
             Style["3\.ba", 18, 
              GrayLevel[0.5]]}, Alignment -> Center]}, Alignment -> Bottom], 
         Spacer[20], 
         Column[{}, Spacings -> 1]}, Alignment -> Center], Background -> 
       GrayLevel[1]]}, Alignment -> Center], ImageSize -> Full], 
   DynamicModuleValues :> {}], Private`inputnome$$ = "ds", 
  Private`giocatore$$ = "ds", Private`punteggio$$ = 0, Private`sorgente$$ = 
  "Web", Private`statusMsg$$ = "Database Web caricato: 77 immagini"}, 
  PanelBox[
   TagBox[GridBox[{
      {
       TemplateBox[{
         StyleBox["\"Sorgente immagini: \"", Bold, StripOnInput -> False], 
         PopupMenuBox[
          Dynamic[Private`sorgente$$], {
          "Web" -> "\"Web (EntityList)\"", "Locale" -> 
           "\"Locale (cartella img)\""}], 
         TemplateBox[{10}, "Spacer1"], 
         ButtonBox[
         "\" Carica Database\"", 
          ButtonFunction :> (Private`statusMsg$$ = "Caricamento in corso..."; 
           If[Private`sorgente$$ === "Web", 
             TrasformazioneImmagini`cacheImmagini = 
              TrasformazioneImmagini`creaDBWeb[]; 
             TrasformazioneImmagini`lengthImageDb = 
              Length[TrasformazioneImmagini`cacheImmagini]; 
             Private`statusMsg$$ = 
              "Database Web caricato: " <> 
               ToString[TrasformazioneImmagini`lengthImageDb] <> " immagini", 
             TrasformazioneImmagini`cacheImmagini = 
              TrasformazioneImmagini`creaDBCartella[]; 
             TrasformazioneImmagini`lengthImageDb = 
              Length[TrasformazioneImmagini`cacheImmagini]; 
             Private`statusMsg$$ = 
              "Database Locale caricato: " <> 
               ToString[TrasformazioneImmagini`lengthImageDb] <> 
               " immagini"]), Background -> RGBColor[0.87, 0.94, 1], 
          BaseStyle -> {FontFamily -> "Verdana", Bold}, Appearance -> 
          "Palette", Method -> "Queued", Evaluator -> Automatic], 
