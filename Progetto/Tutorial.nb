      "], "Real32", ColorSpace -> Automatic, Interleaving -> True], 
    Private`aiuti = 0, Private`mostraValori = False}, 
   Panel[
    Column[{
      Row[{
        Column[{
          Style["La tua immagine", Bold], 
          DynamicModule[{}, 
           Dynamic[
            Show[
             TrasformazioneImmagini`modifyImage[
             Private`img, Private`blur, Private`rotazione, Private`translaX, 
              Private`translaY, Private`colore, Private`MAXTRANSLATIONSTEP], 
             ImageSize -> Medium]], DynamicModuleValues :> {}]}, Alignment -> 
         Center], 
        Spacer[30], 
        Column[{
          Style["Immagine modificata", Bold], 
          Dynamic[
           Show[Private`immagineModificata, ImageSize -> Medium]]}, Alignment -> 
         Center]}, Alignment -> Center], 
      Spacer[20], 
      Row[{
        DynamicModule[{}, 
         Column[{
           Row[{"Blur:       ", 
             Slider[
              Dynamic[Private`blur], {0, 50, 10}, Appearance -> "Labeled"]}], 
           
           Row[{"Rotazione: ", 
             Slider[
              Dynamic[Private`rotazione], {0, 359, 30}, Appearance -> 
              "Labeled"]}], 
           Row[{"Colore:     ", 
             RadioButtonBar[
              Dynamic[Private`colore], {None, 
               RGBColor[1, 0, 0], 
               RGBColor[0, 1, 0], 
               RGBColor[0, 0, 1], 
               RGBColor[1, 1, 0], 
               RGBColor[0, 1, 1], 
               RGBColor[1, 0, 1], 
               RGBColor[1, 0.5, 0]}]}], 
           Row[{"Transla X: ", 
             Slider[
              Dynamic[Private`translaX], {0, 10, 1}, Appearance -> 
              "Labeled"]}], 
           Row[{"Transla Y: ", 
             Slider[
              Dynamic[Private`translaY], {0, 10, 1}, Appearance -> 
              "Labeled"]}]}, Alignment -> Left], DynamicModuleValues :> {}], 
        Spacer[40], 
        Column[{
          Dynamic[
           Style["Partita n: " <> ToString[Private`partite], Bold]], 
          Dynamic[
           Style["Punteggio: " <> ToString[Private`punteggio], Bold]], 
          Dynamic[
           Style["Aiuti: " <> ToString[Private`aiuti], Bold, Green]], 
          Spacer[10], 
          Button[
           Dynamic[
            If[
            Private`mostraValori, "Nascondi soluzione", 
             "Vedi valori di soluzione"]], Private`mostraValori = 
           Not[Private`mostraValori]], 
          Dynamic[
           If[Private`mostraValori, 
            Private`formattaSoluzione[
            Private`blur2, Private`colore2, Private`rotazione2, 
             Private`translaX2, Private`translaY2], ""]], 
          Spacer[10], 
          Button[
          "Genera esercizio", Private`blur = Private`blur2; 
           Private`rotazione = Private`rotazione2; 
           Private`colore = Private`colore2; 
           Private`translaX = Private`translaX2; 
           Private`translaY = Private`translaY2; Null], 
          Spacer[10], 
          Button["Verifica", 
           If[
            
            Private`verifica[{
             Private`blur, Private`colore, Private`rotazione, 
              Private`translaX, Private`translaY}, {
             Private`blur2, Private`colore2, Private`rotazione2, 
              Private`translaX2, Private`translaY2}], 
            Private`punteggioLivello = Max[5 - Private`aiuti, 0]; 
            MessageDialog[
              StringTemplate["Corretto: punteggio `1`, aiuti utilizzati `2`"][
              Private`punteggioLivello, Private`aiuti]]; 
            Private`punteggio = Private`punteggio + Private`punteggioLivello; 
            Private`aiuti = 0; Private`mostraValori = False; 
            Private`partite = Private`partite + 1; 
            Private`pulisci[
             Private`blur, Private`rotazione, Private`translaX, 
              Private`translaY, Private`colore]; 
            Private`img = Private`prossimaImmagine[]; 
            Private`aggiornaParametri[{
              Private`blur2, Private`colore2, Private`rotazione2, 
               Private`translaX2, Private`translaY2}]; 
            Private`immagineModificata = 
             TrasformazioneImmagini`modifyImage[
              Private`img, Private`blur2, Private`rotazione2, 
               Private`translaX2, Private`translaY2, Private`colore2, 
               Private`MAXTRANSLATIONSTEP]; Null, 
            MessageDialog["sbagliato"]]], 
          Button[
          "Next", Private`aiuti = 0; Private`mostraValori = False; 
           Private`partite = Private`partite + 1; 
           Private`pulisci[
            Private`blur, Private`rotazione, Private`translaX, 
             Private`translaY, Private`colore]; 
           Private`img = Private`prossimaImmagine[]; 
           Private`aggiornaParametri[{
             Private`blur2, Private`colore2, Private`rotazione2, 
              Private`translaX2, Private`translaY2}]; 
           Private`immagineModificata = 
            TrasformazioneImmagini`modifyImage[
             Private`img, Private`blur2, Private`rotazione2, 
              Private`translaX2, Private`translaY2, Private`colore2, 
              Private`MAXTRANSLATIONSTEP]; Null], 
          Button[
          "Aiuto", Private`aiuti = Min[Private`aiuti + 1, 5]; 
           If[Private`aiuti >= 1, Private`blur = Private`blur2]; 
           If[Private`aiuti >= 2, Private`rotazione = Private`rotazione2]; 
           If[Private`aiuti >= 3, Private`colore = Private`colore2]; 
           If[Private`aiuti >= 4, Private`translaX = Private`translaX2]; 
           If[Private`aiuti >= 5, Private`translaY = Private`translaY2]; 
           Null], 
          Spacer[10], 
          DynamicModule[{}, 
           Button[
           "Pulisci", 
            Private`pulisci[
             Private`blur, Private`rotazione, Private`translaX, 
              Private`translaY, Private`colore]; Null], 
           DynamicModuleValues :> {}]}, Alignment -> Center, ItemSize -> 20]},
        Alignment -> Center]}, Alignment -> Center], ImageSize -> Full], 
   DynamicModuleValues :> {}]}, 
  PanelBox[
   TagBox[GridBox[{
      {
       TemplateBox[{
         InputFieldBox[
          Dynamic[Private`seed$$], Number], 
         ButtonBox["\"Nuova partita\"", ButtonFunction :> If[
