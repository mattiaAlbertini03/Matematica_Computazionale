  PanelBox[
   TagBox[GridBox[{
      {
       TemplateBox[{
         DynamicModuleBox[{}, 
          ButtonBox[
          "\"Carica Immagine\"", ButtonFunction :> 
           With[{Private`file$ = SystemDialogInput["FileOpen"]}, 
             If[
             Private`file$ =!= $Canceled, Private`img$$ = 
              Import[Private`file$]]], Method -> "Queued", Appearance -> 
           Automatic, Evaluator -> Automatic], DynamicModuleValues :> {}], 
         TemplateBox[{10}, "Spacer1"], 
         DynamicModuleBox[{}, 
          ButtonBox[
          "\"Pulisci\"", 
           ButtonFunction :> (
            Private`pulisci[
             Private`blur$$, Private`rotazione$$, Private`translaX$$, 
              Private`translaY$$, Private`colore$$]; Null), Appearance -> 
           Automatic, Evaluator -> Automatic, Method -> "Preemptive"], 
          DynamicModuleValues :> {}]},
        "Row",
        DisplayFunction->(PaneBox[
          RowBox[{
            TemplateSlotSequence[1, "\[InvisibleSpace]"]}], Alignment -> 
          Center]& ),
        InterpretationFunction->(RowBox[{"Row", "[", 
           RowBox[{
             RowBox[{"{", 
               TemplateSlotSequence[1, ","], "}"}], ",", 
             RowBox[{"Alignment", "\[Rule]", "Center"}]}], "]"}]& )]},
      {
