Cell[BoxData[
 RowBox[{"Button", "[", 
  RowBox[{
   RowBox[{"Style", "[", 
    RowBox[{"\"\<\[FilledRightTriangle]  Inizializza Ambiente\>\"", ",", 
     RowBox[{"FontSize", "->", "16"}], ",", 
     RowBox[{"FontWeight", "->", "Bold"}], ",", 
     RowBox[{"FontColor", "->", "White"}]}], "]"}], ",", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "nb", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"1.", " ", "Notebook", " ", "corrente"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"nb", "=", 
       RowBox[{"EvaluationNotebook", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"2.", " ", "Pulizia", " ", "memoria"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"3.", " ", "Directory", " ", "di", " ", "lavoro"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], "=!=", "$Failed"}], ",", 
        RowBox[{"SetDirectory", "[", 
         RowBox[{"NotebookDirectory", "[", "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"4.", " ", "Caricamento", " ", "pacchetti"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Quiet", "@", 
       RowBox[{"Get", "[", "\"\<TrasformazioneImmagini`\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Quiet", "@", 
       RowBox[{"Get", "[", "\"\<Interfaccia`\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"5.", " ", "Messaggio"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"MessageDialog", "[", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<\[Checkmark]  Ambiente inizializzato!\>\"", ",", 
         RowBox[{"FontSize", "->", "14"}]}], "]"}], "]"}], ";"}]}], "]"}], ",", 
   RowBox[{"Background", "->", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0.2", ",", "0.5", ",", "0.9"}], "]"}]}], ",", 
