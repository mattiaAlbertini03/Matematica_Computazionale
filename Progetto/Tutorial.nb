Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Inizializzazione dell\[CloseCurlyQuote]ambiente di notebook",
  FontWeight->"Bold"],
 ": l\[CloseCurlyQuote]utente deve cliccare sul bottone \
\[OpenCurlyQuote]Inizializza Ambiente\[CloseCurlyQuote] per permettere il \
caricamento della directory di lavoro e dei pacchetti necessari per il \
corretto funzionamento del programma."
}], "ItemNumbered",
 Editable->False,
 CellChangeTimes->{{3.9873328701824293`*^9, 3.987333022245603*^9}, {
