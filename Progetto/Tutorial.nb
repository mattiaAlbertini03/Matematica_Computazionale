Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Evaluation del notebook",
  FontWeight->"Bold"],
 ": a questo punto dobbiamo cliccare sul bottone \[OpenCurlyQuote]Valuta il \
Notebook\[CloseCurlyQuote] per permettere la corretta esecuzione delle \
funzionalit\[AGrave] \[OpenCurlyQuote]Allenamento\[CloseCurlyQuote] e \
\[OpenCurlyQuote]Gioco\[CloseCurlyQuote]."
}], "ItemNumbered",
 Editable->False,
 CellChangeTimes->{{3.9873328701824293`*^9, 3.987333022245603*^9}, 
   3.9873337467696733`*^9, {3.987732194402067*^9, 3.9877322184131937`*^9}, {
