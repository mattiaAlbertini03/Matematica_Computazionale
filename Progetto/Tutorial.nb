Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Evaluation del notebook",
  FontWeight->"Bold"],
 ": l\[CloseCurlyQuote]utente deve quindi cliccare sul bottone \
\[OpenCurlyQuote]Valuta il Notebook\[CloseCurlyQuote] per permettere la \
valutazione del notebook e quindi la corretta esecuzione delle funzionalit\
\[AGrave] \[OpenCurlyQuote]Allenamento\[CloseCurlyQuote] e \
\[OpenCurlyQuote]Gioco\[CloseCurlyQuote]."
}], "ItemNumbered",
 Editable->False,
 CellChangeTimes->{{3.9873328701824293`*^9, 3.987333022245603*^9}, 
