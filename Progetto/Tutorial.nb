Cell[TextData[{
 "Dopo avere effettuato i precedenti passaggi, l\[CloseCurlyQuote]utente pu\
\[OGrave] quindi avviare la partita cliccando sul tasto \[OpenCurlyQuote]",
 StyleBox["Nuova partita",
  FontWeight->"Bold"],
 "\[CloseCurlyQuote].\n\nLa schermata che appare, oltre a presentare le \
stesse funzionalit\[AGrave] di quelle presenti nella sezione \
\[OpenCurlyQuote]Allenamento\[CloseCurlyQuote], propone anche delle nuove \
funzionalit\[AGrave]:"
}], "Text",
