Cell[BoxData[
 ButtonBox[
  StyleBox["\<\"\[FilledRightTriangle]  Inizializza Ambiente\"\>",
   StripOnInput->False,
   FontSize->16,
   FontWeight->Bold,
   FontColor->GrayLevel[1]],
  Appearance->Automatic,
  Background->RGBColor[0.2, 0.5, 0.9],
  ButtonFunction:>
   Module[{$CellContext`dir}, 
    Remove["Global`*"]; $CellContext`dir = NotebookDirectory[]; 
    If[$CellContext`dir === $Failed, 
      MessageDialog["Errore: directory del notebook non trovata!"]; Return[]; 
      Null, SetDirectory[$CellContext`dir]; If[
        Not[
         MemberQ[$Path, $CellContext`dir]], 
        PrependTo[$Path, $CellContext`dir]]; Null]; Get[
      FileNameJoin[{$CellContext`dir, "Classifica.wl"}]]; Get[
      FileNameJoin[{$CellContext`dir, "TrasformazioneImmagini.wl"}]]; Get[
      FileNameJoin[{$CellContext`dir, "Interfaccia.wl"}]]; MessageDialog[
      Style["\[Checkmark]  Ambiente inizializzato!", FontSize -> 14]]; Null],
  Evaluator->Automatic,
  FrameMargins->15,
  ImageSize->{350, 60},
  Method->"Queued"]], "Output",
 Editable->False,
