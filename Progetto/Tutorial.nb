Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Button", "[", 
  RowBox[{
   RowBox[{"Style", "[", 
    RowBox[{"\"\<\[FilledRightTriangle]  Inizializza Ambiente\>\"", ",", 
     RowBox[{"FontSize", "->", "16"}], ",", 
     RowBox[{"FontWeight", "->", "Bold"}], ",", 
     RowBox[{"FontColor", "->", "White"}]}], "]"}], ",", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "dir", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"1.", " ", "Pulizia", " ", "memoria"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "2.", " ", "Controllo", " ", "e", " ", "impostazione", " ", 
        "Directory", " ", "di", " ", "lavoro"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"dir", "=", 
       RowBox[{"NotebookDirectory", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"dir", "==", "$Failed"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "MessageDialog", 
          "[", "\"\<Errore: directory del notebook non trovata!\>\"", "]"}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "]"}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SetDirectory", "[", "dir", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Sicurezza", " ", 
           RowBox[{"extra", ":", 
            RowBox[{
            "aggiungiamo", " ", "la", " ", "directory", " ", "anche", " ", 
             "al", " ", "$Path"}]}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"Not", "[", 
            RowBox[{"MemberQ", "[", 
             RowBox[{"$Path", ",", "dir"}], "]"}], "]"}], ",", 
           RowBox[{"PrependTo", "[", 
            RowBox[{"$Path", ",", "dir"}], "]"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"3.", " ", "Caricamento", " ", "pacchetti"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Get", "[", "\"\<TrasformazioneImmagini.wl\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Get", "[", "\"\<Interfaccia.wl\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"4.", " ", "Messaggio"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"MessageDialog", "[", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<\[Checkmark]  Ambiente inizializzato!\>\"", ",", 
         RowBox[{"FontSize", "->", "14"}]}], "]"}], "]"}], ";"}]}], "]"}], ",", 
   RowBox[{"Background", "->", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0.2", ",", "0.5", ",", "0.9"}], "]"}]}], ",", 
   RowBox[{"FrameMargins", "->", "15"}], ",", 
   RowBox[{"ImageSize", "->", 
    RowBox[{"{", 
     RowBox[{"350", ",", "60"}], "}"}]}], ",", 
   RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}]], "Input",
 Editable->False,
 CellOpen->False,
 CellChangeTimes->{{3.9852345631188126`*^9, 3.985234590279291*^9}, {
