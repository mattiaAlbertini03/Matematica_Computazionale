Cell[CellGroupData[{

Cell["Sfocatura (Blurring)", "Section",
 Editable->False,
 CellChangeTimes->{{3.985418660281992*^9, 3.9854186889265957`*^9}, {
  3.9854187409947453`*^9, 3.9854187445206003`*^9}, {3.9872245963375387`*^9, 
  3.987224607877083*^9}, {3.987335752480768*^9, 3.987335754123542*^9}},
 FontFamily->"Sans Serif",
 CellTags->
  "effetto_blur",ExpressionUUID->"710358f8-a95e-4f2e-a9fe-0a1456dbd126"],

Cell[TextData[{
 "La sfocatura (blur) serve a rendere un\[CloseCurlyQuote]immagine \
pi\[UGrave] morbida riducendo i dettagli nitidi, come i bordi.\nTecnicamente, \
questo avviene tramite una ",
 StyleBox["convoluzione",
  FontWeight->"Bold"],
 ": ogni pixel viene ricalcolato come media pesata dei pixel vicini. Il \
filtro pi\[UGrave] usato \[EGrave] quello gaussiano, che attenua le \
variazioni brusche di colore.\nIn Mathematica, puoi ottenere questo effetto \
usando il comando Blur[image, r], dove r indica l\[CloseCurlyQuote]intensit\
\[AGrave] della sfocatura: maggiore \[EGrave] r, pi\[UGrave] l\
\[CloseCurlyQuote]immagine risulter\[AGrave] sfocata.\n",
 ButtonBox["[1]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_1"],
 " ",
 ButtonBox["[2]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_2"],
 " ",
 ButtonBox["[3]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_3"],
 " ",
 ButtonBox["[4]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_4"]
}], "Text",
 CellChangeTimes->{
  3.987331451579584*^9, {3.987480000231782*^9, 3.987480056184478*^9}, {
   3.987480087408348*^9, 3.9874800874100933`*^9}, {3.989058408423126*^9, 
   3.9890584424196434`*^9}},
 FontFamily->
  "Sans Serif",ExpressionUUID->"ce045841-6f2d-446c-9c0a-09869a20359e"],

