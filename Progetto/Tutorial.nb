  "],
 FontFamily->
  "Sans Serif",ExpressionUUID->"2d3b9c3c-0c5c-4b61-8551-7116ae025445"],

Cell[TextData[{
 "Il pulsante \[OpenCurlyQuote]",
 StyleBox["next\[CloseCurlyQuote]",
  FontWeight->"Bold"],
 " permette di passare ad un round sucessivo senza effettuare la corretta \
verifica dell\[CloseCurlyQuote]immagine come citato precedentemente; "
}], "Item",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGCQBGIQfTTFyX7qxreO1nwVjiD69LzkZZ2b3zqubmsH03N8
Tq8H0X/3a20C0bvOsDoZbX3ryNNxxRlEO1Tt228FpAWuN18D0cX9avdB9B6l
