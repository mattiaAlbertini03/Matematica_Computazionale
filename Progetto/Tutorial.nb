Cell[TextData[{
 "Il pulsante \[OpenCurlyQuote]",
 StyleBox["Risolvi esercizio\[CloseCurlyQuote]",
  FontWeight->"Bold"],
 " permette di impostare ogni slider al valore corretto per la soluzione, \
analogamente a \[OpenCurlyQuote]Mostra soluzione\[CloseCurlyQuote] una volta \
premuto non permetter\[AGrave] di guadagnare punti \
dall\[CloseCurlyQuote]esercizio; "
}], "Item",
