Cell[CellGroupData[{

Cell["Tutorial Allenamento", "Subsection",
 Editable->False,
 CellChangeTimes->{{3.987333838534298*^9, 3.9873338450427103`*^9}, {
  3.987391069909542*^9, 3.987391080116489*^9}},
 FontFamily->
  "Sans Serif",ExpressionUUID->"f50e1e00-91a5-4a87-b7fb-450e8092b5fd"],

Cell[TextData[{
 "In questa sezione \[EGrave] possibile provare applicare le varie \
trasformazioni, per capire bene come ogniuna di esse funziona e come esse \
interagiscono tra di loro. Si pu\[OGrave] optare per lavorare sull\
\[CloseCurlyQuote]immagine di test standard oppure caricarne una propria \
tramite il pulsante \[OpenCurlyQuote]",
 StyleBox["Carica Immagine",
  FontWeight->"Bold"],
 "\[CloseCurlyQuote].\n\nL\[CloseCurlyQuote]utente pu\[OGrave] anche \
usufruire del tasto \[OpenCurlyQuote]",
 StyleBox["Pulisci",
  FontWeight->"Bold"],
 "\[CloseCurlyQuote] per portare l\[CloseCurlyQuote]immagine che sta \
modificando alle condizioni originali."
}], "Text",
 Editable->False,
 CellChangeTimes->{{3.987332428766184*^9, 3.987332570371271*^9}, {
