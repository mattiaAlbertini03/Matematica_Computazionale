            Not[Private`partitaIniziata$$]], Evaluator -> Automatic, Method -> 
          "Preemptive"], 
         TemplateBox[{10}, "Spacer1"], 
         ButtonBox[
          StyleBox[
          "\"\[FilledSquare]  Termina Partita\"", FontSize -> 14, FontWeight -> 
           Bold, FontColor -> GrayLevel[1], StripOnInput -> False], 
          ButtonFunction :> (Private`visual$$ = ""; 
           If[Private`partitaIniziata$$, 
             Classifica`aggiungiPunteggio[
              Private`giocatore$$, Private`punteggio$$]; Null]; 
           Private`partitaIniziata$$ = False; 
           Private`visual$$ = Private`ClassificaPanel[]; Null), Background -> 
          RGBColor[0.8, 0.1, 0.1], FrameMargins -> 12, ImageSize -> {200, 45},
           Enabled -> Dynamic[Private`partitaIniziata$$], Appearance -> 
          Automatic, Evaluator -> Automatic, Method -> "Preemptive"]},
        "RowDefault"]},
      {
       DynamicBox[ToBoxes[
         Style[Private`errorMsg$$, Red, Bold], StandardForm],
        ImageSizeCache->{0., {0., 6.25}}]},
      {
       DynamicBox[ToBoxes[Private`visual$$, StandardForm],
        ImageSizeCache->{
         797.0000000000001, {440.96624755859375`, 446.77801513671875`}}]}
     },
     DefaultBaseStyle->"Column",
     GridBoxAlignment->{"Columns" -> {{Center}}},
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
    "Column"]],
  DynamicModuleValues:>{}]], "Output",
 Editable->False,
