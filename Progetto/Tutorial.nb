Cell[CellGroupData[{

Cell["Rotazione", "Section",
 Editable->False,
 CellChangeTimes->{{3.985418660281992*^9, 3.9854186889265957`*^9}, {
  3.9854187409947453`*^9, 3.9854187445206003`*^9}, {3.9854188668368607`*^9, 
  3.9854188678528643`*^9}},
 FontFamily->"Sans Serif",
 CellTags->"rotazione",ExpressionUUID->"54bbfd3d-7419-42b8-8db1-3c6cef3facdd"],

Cell[TextData[{
 "La rotazione sposta l\[CloseCurlyQuote]immagine attorno a un punto \
centrale, mantenendone forma e proporzioni.\nPoich\[EAcute] dopo la rotazione \
i pixel spesso non si allineano perfettamente alla griglia originale, il \
computer deve interpolare, cio\[EGrave] stimare il colore dei nuovi pixel \
basandosi su quelli vicini ",
 ButtonBox["[5]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_5"],
 ":\n\t",
 StyleBox["Nearest-neighbor",
  FontWeight->"Bold"],
 ": Veloce, ma meno precisa.\n\t",
 StyleBox["Bilineare",
  FontWeight->"Bold"],
 ": Pi\[UGrave] precise e nitide, perch\[EAcute] calcolano medie pesate su pi\
\[UGrave] pixel.\nIn Mathematica, il comando ImageRotate[image, \[Theta]] \
esegue automaticamente la rotazione, gestisce \
l\[CloseCurlyQuote]interpolazione e riempie con un colore fisso (solitamente \
nero) gli angoli vuoti creati dal movimento. ",
 ButtonBox["[6]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_6"],
 " ",
 ButtonBox["[7]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_7"],
 " ",
 ButtonBox["[8]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_8"]
}], "Text",
 Editable->False,
 CellChangeTimes->{{3.987332159471821*^9, 3.987332171058844*^9}, {
  3.987480127021389*^9, 3.987480213214604*^9}, {3.9890591146455765`*^9, 
  3.9890591827857704`*^9}},
 FontFamily->
  "Sans Serif",ExpressionUUID->"890d4c94-626a-491e-ab6e-96fcce9ab9a6"],

