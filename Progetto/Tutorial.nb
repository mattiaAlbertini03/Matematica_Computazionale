Cell[TextData[{
 "Il pulsante \[OpenCurlyQuote]",
 StyleBox["verifica\[CloseCurlyQuote]",
  FontWeight->"Bold"],
 " permette di verificare se le trasformazioni applicate dall\
\[CloseCurlyQuote]utente corrispondano a quelle applicate sull\
\[CloseCurlyQuote]immagine da riprodurre. Se la verifica restituisce un \
risultato positivo vengono assegnati da 0 a 5 punti (in base a quanti \
\[OpenCurlyQuote]aiuti\[CloseCurlyQuote] si sono usufruiti) e si passa ad un \
round successivo, altrimenti appare un pop-up che segnala \
l\[CloseCurlyQuote]errore."
}], "Item",
