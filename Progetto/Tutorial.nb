Cell[TextData[{
 "Il pulsante \[OpenCurlyQuote]",
 StyleBox["pulisci\[CloseCurlyQuote] ",
  FontWeight->"Bold"],
 "serve per riportare l\[CloseCurlyQuote]immagine, ed i valori di \
trasformazioni applicate, ai parametri iniziali. "
}], "Item",
 CellChangeTimes->CompressedData["
