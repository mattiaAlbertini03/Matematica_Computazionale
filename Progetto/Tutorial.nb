AwCLytQl
  "],
 FontFamily->
  "Sans Serif",ExpressionUUID->"fe76ace3-36b7-49b5-8856-3e060555ac0b"],

Cell[TextData[{
 "Il pulsante \[OpenCurlyQuote]",
 StyleBox["aiuto\[CloseCurlyQuote]",
  FontWeight->"Bold"],
 " fornisce un suggerimento all\[CloseCurlyQuote]utente impostando un valore, \
tra le varie trasformazioni applicate, sul corretto parametro. N.B. l\
\[CloseCurlyQuote]uso di questo pulsante toglie un punto dal punteggio finale;"
}], "Item",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGCQAGIQfTTFyX7qxreO1nwVjiD69LzkZZ2b3zqubmsH03N8
