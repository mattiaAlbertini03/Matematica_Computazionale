Cell[TextData[{
 StyleBox["N.B. ",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 "Prima di continuare attendere la comparsa del pop-up che indica la corretta \
inizializzazione dell\[CloseCurlyQuote]ambiente e cliccare sul pulsante \
\[OpenCurlyQuote]ok\[CloseCurlyQuote]."
}], "SubitemNumbered",
 Editable->False,
 CellChangeTimes->{{3.9873328701824293`*^9, 3.987333022245603*^9}, {
