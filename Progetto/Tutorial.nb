Cell[TextData[{
 "Infine, premendo il pulsante \[OpenCurlyQuote]",
 StyleBox["Termina Partita\[CloseCurlyQuote],",
  FontWeight->"Bold"],
 " l\[CloseCurlyQuote]utente pu\[OGrave] terminare la propria sessione di \
gioco. \n\nAl termine della sessione di gioco appare a schermo la classifica \
che tiene traccia dei dieci migliori giocatori e dei loro punteggi."
}], "Text",
