         InputFieldBox[
          Dynamic[Private`inputnome$$], String, FieldHint -> 
          "Nome giocatore"], 
         TemplateBox[{5}, "Spacer1"], 
         ButtonBox[
          StyleBox["\"Nuova partita\"", 
           GrayLevel[1], Bold, 14, StripOnInput -> False], ButtonFunction :> 
          If[TrasformazioneImmagini`lengthImageDb == 0, 
            Private`errorMsg$$ = "Errore: carica prima il database immagini!"; 
            Private`visual$$ = ""; Null, 
            If[
             IntegerQ[Private`seed$$], 
             If[
             Private`inputnome$$ == "", 
              Private`errorMsg$$ = "Errore: devi inserire un nome"; 
              Private`visual$$ = ""; Null, Private`errorMsg$$ = ""; 
              Private`visual$$ = ""; 
              Private`giocatore$$ = Private`inputnome$$; 
              Private`punteggio$$ = 0; 
              Private`visual$$ = 
