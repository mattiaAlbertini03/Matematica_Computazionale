Cell[CellGroupData[{

Cell["Traslazione", "Section",
 Editable->False,
 CellChangeTimes->{{3.985418660281992*^9, 3.9854186889265957`*^9}, {
  3.9854187409947453`*^9, 3.9854187445206003`*^9}, {3.98541885960674*^9, 
  3.9854188636343813`*^9}, {3.9872243037802343`*^9, 3.987224308378282*^9}},
 FontFamily->"Sans Serif",
 CellTags->
  "trasposizione",ExpressionUUID->"ade741c8-ae23-4ff4-97c9-a464a8da3822"],

Cell[TextData[{
 "La traslazione \[EGrave] lo spostamento di un\[CloseCurlyQuote]immagine \
lungo gli assi orizzontale e verticale. \[CapitalEGrave] una trasformazione \
che mantiene inalterate le proporzioni, le distanze e gli angoli originali.",
 ButtonBox["[15]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_15"],
 " ",
 ButtonBox["[16]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_16"],
 "\nIl punto principale della traslazione digitale \[EGrave] la gestione dei \
bordi, ovvero cosa succede ai pixel che escono dall\[CloseCurlyQuote]area \
dell\[CloseCurlyQuote]immagine:\n\t",
 StyleBox["Colori fissi",
  FontWeight->"Bold"],
 " o ",
 StyleBox["riflessione",
  FontWeight->"Bold"],
 ": Si riempiono gli spazi vuoti con un colore (spesso nero) o \t\tripetendo \
i bordi.\n\t",
 StyleBox["Wrap-around",
  FontWeight->"Bold"],
 " (o Tiling): I pixel che escono da un lato \[OpenCurlyDoubleQuote]rientrano\
\[CloseCurlyDoubleQuote] dal lato opposto, \t\tcreando un effetto a ciclo \
continuo (come se l\[CloseCurlyQuote]immagine fosse su un toro).\nIn \
Mathematica, per ottenere questa traslazione ciclica in modo rapido, si \
utilizza la funzione RotateRight applicata alla matrice dei pixel. Questo \
metodo \[EGrave] molto efficiente perch\[EAcute] non richiede di aggiungere \
bordi o copiare i dati, ma sposta semplicemente l\[CloseCurlyQuote]ordine dei \
pixel.",
 ButtonBox["[17]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_17"],
 " ",
 ButtonBox["[18]",
  BaseStyle->"Hyperlink",
  ButtonData->"bib_18"]
}], "Text",
 Editable->False,
 CellChangeTimes->{{3.987331832401475*^9, 3.987331923893936*^9}, {
   3.9874802663506517`*^9, 3.987480276363586*^9}, {3.9874803157514267`*^9, 
