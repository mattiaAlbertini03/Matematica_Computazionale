  3.987500291229021*^9, 3.987500344665666*^9}, {3.987500476775819*^9, 
  3.987500476779818*^9}},
 FontFamily->
  "Sans Serif",ExpressionUUID->"f32ee053-ad20-4e18-bee8-d0b533f736bd"],

Cell[TextData[StyleBox["Un altra possibile aggiunta pu\[OGrave] essere \
aumentare il database di immagini con cui il notebook lavora. ", "Item",
 FontFamily->"Sans Serif"]], "Item",
 CellChangeTimes->{{3.9864446715425463`*^9, 3.9864446916795263`*^9}, {
