Cell[CellGroupData[{

Cell["Tutorial Allenamento", "Subsection",
 Editable->False,
 CellChangeTimes->{{3.987333838534298*^9, 3.9873338450427103`*^9}, {
  3.987391069909542*^9, 3.987391080116489*^9}},
 FontFamily->
  "Sans Serif",ExpressionUUID->"f50e1e00-91a5-4a87-b7fb-450e8092b5fd"],

Cell[TextData[{
 "In questa sezione \[EGrave] possibile provare ad applicare le varie \
trasformazioni, per capire bene come ognuna di esse funziona e come esse \
interagiscono tra di loro. Si pu\[OGrave] optare per lavorare sull\
\[CloseCurlyQuote]immagine di test standard oppure caricarne una propria \
tramite il pulsante \[OpenCurlyQuote]",
 StyleBox["Carica Immagine",
  FontWeight->"Bold"],
 "\[CloseCurlyQuote].\n\nSi pu\[OGrave] anche usufruire del tasto \
\[OpenCurlyQuote]",
 StyleBox["Pulisci",
  FontWeight->"Bold"],
 "\[CloseCurlyQuote] per portare l\[CloseCurlyQuote]immagine che si sta \
modificando alle condizioni originali."
}], "Text",
 Editable->False,
 CellChangeTimes->{{3.987332428766184*^9, 3.987332570371271*^9}, {
   3.987388457679611*^9, 3.9873884617423553`*^9}, {3.988092762793601*^9, 
   3.9880927854163523`*^9}, {3.9880928277153463`*^9, 
