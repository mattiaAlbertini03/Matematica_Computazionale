Cell[TextData[StyleBox["Commenti ",
 FontFamily->"Sans Serif"]], "Section",
 Editable->False,
 CellChangeTimes->{{3.986444601964718*^9, 3.986444633092002*^9}},
 FontFamily->"Sans Serif",
 CellTags->"commenti",ExpressionUUID->"9a1623fb-cb92-4a13-bd8a-06a537db6e78"],

Cell[TextData[{
 StyleBox["HoldFirst e HoldAll",
  FontFamily->"Sans Serif",
  FontWeight->"Bold"],
 StyleBox["\nNel progetto questo meccanismo si \[EGrave] rivelato essenziale \
per permettere ai controlli grafici dell\[CloseCurlyQuote]interfaccia di \
aggiornare direttamente le variabili di stato del DynamicModule. \
https://reference.wolfram.com/language/ref/HoldFirst.html\n\n",
  FontFamily->"Sans Serif"],
 StyleBox["SystemDialogInput\n",
  FontFamily->"Sans Serif",
  FontWeight->"Bold"],
 StyleBox["Nel progetto questo meccanismo \[EGrave] risultato necessario al \
fine di offrire un\[CloseCurlyQuote]interazione intuitiva tra interfaccia ed \
utente. https://reference.wolfram.com/language/ref/SystemDialogInput.html?q=\
SystemDialogInput\n\n",
  FontFamily->"Sans Serif"],
 StyleBox["Accessibilit\[AGrave]",
  FontFamily->"Sans Serif",
  FontWeight->"Bold"],
 StyleBox["\nNella progettazione dell\[CloseCurlyQuote]interfaccia si \
\[EGrave] prestata attenzione agli aspetti di accessibilit\[AGrave] visiva. \
\[CapitalEGrave] stato adottato un font Sans Serif per migliorare la \
leggibilit\[AGrave] per gli utenti affetti da dislessia. La codifica \
cromatica dei bottoni segue le convenzioni visive comunemente associate a \
determinate funzionalit\[AGrave] \[LongDash] rosso per azioni terminali, \
verde per conferme. L\[CloseCurlyQuote]allineamento dei testi \[EGrave] stato \
impostato a sinistra per evitare spaziature irregolari che potrebbero \
ostacolare la lettura.\n\n",
  FontFamily->"Sans Serif"],
 StyleBox["Gestione della memoria",
  FontFamily->"Sans Serif",
  FontWeight->"Bold"],
 StyleBox["\nPer evitare rallentamenti dovuti all\[CloseCurlyQuote]accumulo \
in memoria di copie ridondanti delle immagini modificate, \[EGrave] stata \
adottata una strategia di sovrascrittura delle variabili: anzich\[EAcute] \
allocare nuove aree di memoria ad ogni aggiornamento, il contenuto della \
variabile viene sovrascritto con il nuovo valore. A questo si affianca il \
meccanismo interno di garbage collection di Mathematica, che libera \
automaticamente la memoria occupata da oggetti non pi\[UGrave] referenziati, \
mantenendo l\[CloseCurlyQuote]occupazione di memoria sotto controllo anche in \
sessioni prolungate.\n\n",
  FontFamily->"Sans Serif"],
 StyleBox["Entity",
  FontFamily->"Sans Serif",
  FontWeight->"Bold"],
 StyleBox["   \nNel progetto il sistema Entity \[EGrave] stato scelto come \
sorgente per il database di immagini web, in quanto garantisce immagini di \
qualit\[AGrave] omogenea associate a soggetti ben definiti e riconoscibili. \
Un aspetto critico emerso durante lo sviluppo riguarda la dimensione dei \
batch: domini generici come \[OpenCurlyDoubleQuote]Species\
\[CloseCurlyDoubleQuote] o \[OpenCurlyDoubleQuote]Person\
\[CloseCurlyDoubleQuote] contengono centinaia di migliaia di entit\[AGrave], \
rendendo il caricamento dell\[CloseCurlyQuote]intera lista proibitivo. Per \
ovviare a questo problema si \[EGrave] ricorso a due strategie complementari: \
l\[CloseCurlyQuote]utilizzo di sottoclassi specifiche tramite EntityClass \
\[LongDash] come \[OpenCurlyDoubleQuote]MammalSpecies\[CloseCurlyDoubleQuote] \
per le specie o \[OpenCurlyDoubleQuote]Element\[CloseCurlyDoubleQuote] per \
gli elementi chimici \[LongDash] che circoscrivono il dominio a insiemi di \
dimensione ragionevole, e l\[CloseCurlyQuote]utilizzo di SampledEntityClass, \
che estrae un campione casuale di dimensione fissa senza scaricare l\
\[CloseCurlyQuote]intera lista. Inoltre, poich\[EAcute] non tutte le entit\
\[AGrave] dispongono di un\[CloseCurlyQuote]immagine associata nel \
Knowledgebase, \[EGrave] stata implementata la funzione filterWithImages, che \
filtra preventivamente le entit\[AGrave] prive di immagine tramite \
EntityValue e ImageQ, garantendo che il database finale contenga \
esclusivamente entit\[AGrave] con immagine effettivamente disponibile. \
https://reference.wolfram.com/language/ref/Entity.html\n\n",
  FontFamily->"Sans Serif"],
 StyleBox["Scelta del formato .wl per i package (invece che .m) ",
  FontFamily->"Sans Serif",
  FontWeight->"Bold"],
 StyleBox["\nI package Mathematica possono essere salvati con estensione .m o \
.wl. Il formato .m \[EGrave] il formato storico, ma essendo condiviso con \
MATLAB pu\[OGrave] generare ambiguit\[AGrave] nei tool di sviluppo e nei \
sistemi di controllo versione. Il formato .wl (Wolfram Language) \[EGrave] \
invece il formato ufficialmente raccomandato da Wolfram a partire dalla \
versione 10, e identifica inequivocabilmente il file come codice Wolfram \
Language. Per queste ragioni, nel progetto si \[EGrave] scelto di adottare \
.wl, privilegiando chiarezza semantica e coerenza con le convenzioni della \
documentazione ufficiale. \
https://reference.wolfram.com/language/ref/format/WL.html\n\n",
  FontFamily->"Sans Serif"],
 StyleBox["Diagramma delle dipendenze dei pacchetti:\n",
  FontFamily->"Sans Serif",
  FontWeight->"Bold"],
 StyleBox["Per garantire una struttura chiara e ordinata, abbiamo adottato il \
design pattern MVC (Model-View-Controller), suddividendo il progetto in tre \
componenti distinte:\n\t",
  FontFamily->"Sans Serif"],
 StyleBox["View", "Item",
  FontFamily->"Sans Serif",
  FontWeight->"Bold"],
 StyleBox[": Gestita dal package ", "Item",
  FontFamily->"Sans Serif"],
 StyleBox["Interfaccia", "Item",
  FontFamily->"Sans Serif",
  FontSlant->"Italic"],
 StyleBox[", che si occupa esclusivamente della componente visiva e grafica \
del software.\n\t", "Item",
  FontFamily->"Sans Serif"],
 StyleBox["Model", "Item",
  FontFamily->"Sans Serif",
  FontWeight->"Bold"],
 StyleBox[": Delegata ai package ", "Item",
  FontFamily->"Sans Serif"],
 StyleBox["Classifica", "Item",
  FontFamily->"Sans Serif",
  FontSlant->"Italic"],
 StyleBox[" e ", "Item",
  FontFamily->"Sans Serif"],
 StyleBox["Trasformazione Immagini", "Item",
  FontFamily->"Sans Serif",
  FontSlant->"Italic"],
 StyleBox[", che racchiudono tutta la logica applicativa e \
l\[CloseCurlyQuote]elaborazione dei dati.\n\t", "Item",
  FontFamily->"Sans Serif"],
 StyleBox["Controller", "Item",
  FontFamily->"Sans Serif",
  FontWeight->"Bold"],
 StyleBox[": Implementato all\[CloseCurlyQuote]interno del ", "Item",
  FontFamily->"Sans Serif"],
 StyleBox["notebook", "Item",
  FontFamily->"Sans Serif",
  FontSlant->"Italic"],
 StyleBox[", che funge da intermediario gestendo \
l\[CloseCurlyQuote]interazione diretta con l\[CloseCurlyQuote]utente.", "Item",
  FontFamily->"Sans Serif"],
 StyleBox["\nPer permettere questa comunicazione fluida, le funzioni chiave \
dei package sono state definite come pubbliche. Questa scelta architetturale \
non solo rende il codice altamente modulare, ma offre un importante vantaggio \
in termini di riuso: i moduli di classificazione e trasformazione delle \
immagini sono completamente indipendenti e pronti per essere utilizzati da \
qualsiasi altro utente nell\[CloseCurlyQuote]ambiente Mathematica.",
  FontFamily->"Sans Serif"]
}], "Text",
 CellChangeTimes->{{3.985419971968768*^9, 3.985420032206279*^9}, {
   3.986020333501089*^9, 3.9860203898618193`*^9}, {3.9860204380928926`*^9, 
   3.9860204500622063`*^9}, {3.9860210556658697`*^9, 3.986021057489222*^9}, {
   3.986021103379875*^9, 3.986021104823743*^9}, {3.986021453718457*^9, 
   3.986021473037306*^9}, 3.986021567563242*^9, {3.986021820026458*^9, 
   3.986021825479765*^9}, {3.98644304236705*^9, 3.9864430454621553`*^9}, 
   3.98644324166531*^9, {3.986444327078587*^9, 3.986444352447597*^9}, {
   3.986444636392407*^9, 3.9864446443433037`*^9}, {3.9872352391360188`*^9, 
   3.98723527311854*^9}, {3.987236106318277*^9, 3.987236110500844*^9}, {
   3.987328255158584*^9, 3.987328274790071*^9}, {3.987328322083704*^9, 
   3.987328353630372*^9}, {3.987328856300111*^9, 3.987328860028915*^9}, {
   3.987675071625202*^9, 3.9876751401809673`*^9}, {3.9876751767677975`*^9, 
   3.9876751868572807`*^9}, {3.9876763203069515`*^9, 
   3.9876763628563786`*^9}, {3.9876768206914616`*^9, 
   3.9876768328976345`*^9}, {3.987676905858223*^9, 3.9876769067293167`*^9}, {
   3.9876772946130466`*^9, 3.9876773282566795`*^9}, 3.987736044149582*^9, {
   3.987736101678321*^9, 3.9877361707358828`*^9}, {3.9877363365500402`*^9, 
   3.987736396360321*^9}, {3.9877364927488337`*^9, 3.987736505443337*^9}, {
   3.9877365704402533`*^9, 3.987736577047328*^9}, 3.9877367623255453`*^9, {
   3.987736807564746*^9, 3.987736814408578*^9}, {3.987924183949532*^9, 
   3.987924186125547*^9}, 3.987924253643258*^9, {3.9879242866554337`*^9, 
   3.987924380257428*^9}, 3.987924519067916*^9, {3.988094107810601*^9, 
   3.988094151253666*^9}, {3.988103794244337*^9, 3.988103795522908*^9}, {
   3.98810386733222*^9, 3.9881039134744663`*^9}, 3.9881039621768713`*^9, {
   3.988173927871004*^9, 3.9881741587636223`*^9}, {3.988174431676897*^9, 
   3.9881745373952923`*^9}, 3.988174610527092*^9, {3.9881746806660156`*^9, 
   3.9881746813491554`*^9}},
 FontFamily->
  "Sans Serif",ExpressionUUID->"50250b55-64ec-499d-ad82-b514203f769b"],

