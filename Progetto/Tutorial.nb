Cell[CellGroupData[{

Cell[TextData[StyleBox["Lavoro futuro",
 FontFamily->"Sans Serif"]], "Section",
 CellChangeTimes->{{3.98644464575837*^9, 3.986444667432023*^9}},
 FontFamily->"Sans Serif",
 CellTags->
  "lavoro_futuro",ExpressionUUID->"c197e1d6-4099-4d0d-a1e2-fd39f3995a1a"],

Cell[TextData[StyleBox["Un possibile lavoro futuro su questo notebook pu\
\[OGrave] essere dato dall\[CloseCurlyQuote]aggiunta di altre trasformazioni \
sulle immagini da insegnare all\[CloseCurlyQuote]utente, come ad esempio il \
negativo dell\[CloseCurlyQuote]immagine o la saturazione.", "Item",
 FontFamily->"Sans Serif"]], "Item",
 CellChangeTimes->{{3.9864446715425463`*^9, 3.9864446916795263`*^9}, {
  3.987237182780486*^9, 3.987237208015874*^9}, {3.9872373481356297`*^9, 
  3.98723736416743*^9}, {3.987274917554603*^9, 3.987274949897882*^9}, {
  3.987313384120294*^9, 3.987313470967908*^9}, {3.987313818365478*^9, 
  3.987313919898061*^9}, {3.987324398543724*^9, 3.987324405874263*^9}, {
  3.987328029205298*^9, 3.9873282339295053`*^9}, {3.987412768915791*^9, 
  3.98741276985326*^9}, {3.9875002435216923`*^9, 3.98750025253389*^9}, {
  3.987500291229021*^9, 3.987500344665666*^9}, {3.987500475254322*^9, 
  3.987500475258903*^9}},
 FontFamily->
  "Sans Serif",ExpressionUUID->"3f8a5205-6e0f-4930-88a1-bce8cb5c6dc1"],

Cell[TextData[StyleBox["Oltre a questo si potrebbe aggiungere nel gioco \
impostare dei livelli di difficolt\[AGrave] andando a ridurre o incrementare \
il numero di scelte possibili per i parametri delle trasformazioni o \
riducendo il numero di aiuti possibili. ", "Item",
 FontFamily->"Sans Serif"]], "Item",
 CellChangeTimes->{{3.9864446715425463`*^9, 3.9864446916795263`*^9}, {
  3.987237182780486*^9, 3.987237208015874*^9}, {3.9872373481356297`*^9, 
  3.98723736416743*^9}, {3.987274917554603*^9, 3.987274949897882*^9}, {
  3.987313384120294*^9, 3.987313470967908*^9}, {3.987313818365478*^9, 
  3.987313919898061*^9}, {3.987324398543724*^9, 3.987324405874263*^9}, {
